{
  "themeMode": "dark",
  "themeColors": {
    "dark": {
      "surface": "#11141b",
      "pill": "#121722"
    },
    "light": {
      "surface": "#f5f6f8",
      "pill": "#ffffff"
    }
  },
  "wallpaper": "~/Pictures/Wallpapers/eclipse.png",
  "wallpaperMode": "crop",
  "bar": {
    "accent": "#7cc7f5",
    "surface": "#11141b",
    "pill": "#121722",
    "pillBorder": "#2b3547",
    "text": "#cdd6e6",
    "layout": "pills",
    "edge": "top",
    "display": "all",
    "unifiedCorners": false,
    "panelHeight": 34,
    "pillRadius": 12,
    "sideMargin": 10,
    "fontSize": 12,
    "iconSize": 15,
    "pillOpacity": 1,
    "calendarMedia": true,
    "calendarMediaPosition": "bottom",
    "calendarNotificationsSide": "right",
    "calendarWidth": 680,
    "elements": {
      "appMenu": true,
      "workspaces": true,
      "clock": true,
      "tray": true,
      "bluetooth": true,
      "network": true,
      "volume": true,
      "brightness": true,
      "battery": true,
      "power": true
    },
    "elementLayout": {
      "left": [
        "appMenu",
        "workspaces"
      ],
      "center": [
        "clock"
      ],
      "right": [
        "tray",
        "bluetooth",
        "network",
        "volume",
        "brightness",
        "battery",
        "power"
      ]
    },
    "pills": {
      "left": 0,
      "center": 0.5,
      "right": 1
    }
  },
  "hypr": {
    "border1": "#0292e3",
    "border2": "#01d6be",
    "gradient": true,
    "angle": 45,
    "inactive": "#0f3246",
    "borderSize": 1,
    "rounding": 5,
    "gapsIn": 5,
    "gapsOut": 5,
    "blur": true,
    "blurSize": 10,
    "alacrittyBlur": true,
    "alacrittyBlurStrength": 60,
    "animWindowOpen": "popin 87%",
    "animWindowClose": "popin 87%",
    "animWorkspace": "slide",
    "animLayer": "fade",
    "animOpenCurve": "easy",
    "animCloseCurve": "linear",
    "animSpeed": 10
  },
  "idle": {
    "enabled": true,
    "dim": true,
    "dimTimeout": 150,
    "dimLevel": 10,
    "lock": true,
    "lockTimeout": 300
  },
  "notifications": {
    "position": "top-right",
    "timeout": 5000,
    "maxVisible": 4,
    "pauseOnHover": true,
    "persistent": false,
    "showAppIcon": true,
    "showAppName": true,
    "calendarNotifications": true,
    "lowBatteryEnabled": true,
    "lowBatteryThreshold": 20
  }
}
